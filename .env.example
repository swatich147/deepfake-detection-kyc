# =============================================================================
# Docker environment — copy to .env on your demo laptop
# =============================================================================
# cp .env.example .env

# Secret key (change if exposing beyond your lab network)
SECRET_KEY=demo-secret-key-change-me

# AI mode: true = fast mock scores for live demo | false = CPU video analysis
MOCK_INFERENCE=true

# Optional: restrict Django hosts (comma-separated). Use * for demo on LAN.
ALLOWED_HOSTS=*

# Demo login (created automatically on first start)
# Email:    demo@example.com
# Password: demo12345
