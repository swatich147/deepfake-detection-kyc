# Django Backend Environment Variables (zero-cost demo)

# Django
DEBUG=True
SECRET_KEY=demo-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — SQLite (default, no Docker DB needed)
# For PostgreSQL instead: postgres://postgres:postgres123@localhost:5432/deepfake_kyc
DATABASE_URL=sqlite:///db/demo.sqlite3

# AI Service
AI_SERVICE_URL=http://localhost:8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional cloud storage (leave empty for demo)
USE_S3_STORAGE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
